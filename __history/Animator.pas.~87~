procedure DrawGrid(Canvas: TCanvas; Width, Height: Integer; CellSize: Integer);
var
  i: Integer;
begin
  Canvas.Pen.Color := clGray; // Цвет линий сетки
  Canvas.Pen.Width := 1;      // Толщина линий
  // Вертикальные линии
  i := 0;
  while i < Width do
  begin
    Canvas.MoveTo(i, 0);
    Canvas.LineTo(i, Height);
    Inc(i, CellSize);
  end;
  // Горизонтальные линии
  i := 0;
  while i < Height do
  begin
    Canvas.MoveTo(0, i);
    Canvas.LineTo(Width, i);
    Inc(i, CellSize);
  end;
end;

