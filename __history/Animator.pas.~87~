procedure DrawBG(Canvas: TCanvas; Width, Height: Integer);
var
  TableRect, BlinRect: TRect;
  TableHeight, TableWidth, TableTop, BlinWidth, BlinHeight, i: Integer;
begin
  // Рисуем задний фон (небо и землю)
  canvas.Brush.Color := clSkyBlue;
  canvas.FillRect(Rect(0, 0, Width, Height div 2)); // Верхняя половина — небо
  canvas.Brush.Color := clGreen;
  canvas.FillRect(Rect(0, Height div 2, Width, Height)); // Нижняя половина — земля

  // Параметры тумбочки (подставки)
  TableHeight := 150;  // Высота тумбочки
  TableWidth := 100;   // Ширина тумбочки
  TableTop := Height div 2 - TableHeight; // Верхняя граница тумбочки

  // Координаты тумбочки (центрируется)
  TableRect.Left := ((Width - TableWidth) div 2)-200;
  TableRect.Top := TableTop+380;
  TableRect.Right := TableRect.Left + TableWidth;
  TableRect.Bottom := Height -100;

  // Рисуем тумбочку
  canvas.Brush.Color := RGB(139, 69, 19); // Темно-коричневый цвет
  canvas.Pen.Color := clBlack;
  canvas.Rectangle(TableRect);

  // Параметры блинов
  BlinWidth := TableWidth - 20; // Ширина блинов чуть меньше ширины тумбочки
  BlinHeight := 10;            // Высота каждого блина
  canvas.Brush.Color := clBlack;

  // Рисуем стопку блинов. Если NumBlins уменьшилось, меньше блоков будет отрисовано.
for i := 0 to NumBlins - 1 do
  begin
    BlinRect.Left := TableRect.Left + 10 + (i * 2); // каждый блин с небольшим смещением
    BlinRect.Right := BlinRect.Left + BlinWidth - (i * 4);
    BlinRect.Top := TableRect.Top - (i + 1) * BlinHeight;
    BlinRect.Bottom := BlinRect.Top + BlinHeight;
    Canvas.Rectangle(BlinRect);
  end;
end;

